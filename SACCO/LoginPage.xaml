<Page
    x:Class="SACCO.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PageBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Navy header -->
        <Grid Grid.Row="0" Background="{StaticResource NavyBrush}" Padding="0,14">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="KAMPALA COMMUNITY SACCO"
                           Foreground="White" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Staff Management Portal"
                           Foreground="{StaticResource GoldBrush}" FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Login card -->
        <Border Grid.Row="1" Width="340"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.5"
                CornerRadius="8" Padding="24,20">
            <StackPanel>
                <TextBlock Text="STAFF LOGIN"
                           Foreground="{StaticResource NavyBrush}"
                           FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <TextBlock Text="Email Address" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource NavyBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="EmailTextBox"
                         PlaceholderText="Enter staff email address"
                         FontSize="12" Margin="0,0,0,12"
                         KeyDown="Input_KeyDown"/>

                <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource NavyBrush}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox"
                             PlaceholderText="Enter password"
                             FontSize="12" Margin="0,0,0,16"
                             KeyDown="Input_KeyDown"/>

                <Button x:Name="LoginButton" Content="LOGIN"
                        Background="{StaticResource BlueBrush}" Foreground="White"
                        FontSize="12" FontWeight="Bold"
                        Width="100" Height="34"
                        HorizontalAlignment="Center"
                        Click="LoginButton_Click"/>

                <TextBlock Text="Authorized SACCO staff only"
                           FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="2" Text="Kampala Community SACCO © 2026"
                   FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
    </Grid>
</Page>