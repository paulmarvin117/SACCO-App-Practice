<Page
    x:Class="SACCO.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PageBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C8C9CE"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="204"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <DataTemplate x:Key="SectionHeaderTemplate">
            <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
        </DataTemplate>

        <Style x:Key="TileCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TileValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Page.Resources>

    <!-- ============ TOP APP BAR ============ -->
    <Page.TopAppBar>
        <CommandBar x:Name="TopBar"
                    Background="{StaticResource NavyBrush}" Foreground="White"
                    IsSticky="True" IsOpen="True"
                    ClosedDisplayMode="Compact"
                    DefaultLabelPosition="Collapsed">

            <CommandBar.Content>
                <StackPanel Margin="24,14,0,12">
                    <TextBlock Text="KAMPALA COMMUNITY SACCO"
                               FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="WelcomeText" FontSize="12"
                               Foreground="{StaticResource GoldBrush}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="RoleText" FontSize="11" Foreground="White"/>
                </StackPanel>
            </CommandBar.Content>

            <AppBarButton Icon="Home"    Label="Home"     Click="TopBarButton_Click"/>
            <AppBarButton Icon="Refresh" Label="Refresh"  Click="TopBarButton_Click"/>
            <AppBarButton Icon="Print"   Label="Print"    Click="TopBarButton_Click"/>
            <AppBarButton Icon="Setting" Label="Settings" Click="TopBarButton_Click"/>
            <AppBarButton x:Name="LogoutButton" Icon="Back" Label="Logout"
                          Background="Red" Click="LogoutButton_Click"/>
        </CommandBar>
    </Page.TopAppBar>

    <!-- ============ HUB ============ -->
    <Hub Header="SACCO Management Dashboard" Margin="0,100,0,0">

        <!-- Section 1: Overview (Canvas dashboard) -->
        <HubSection Header="Overview" HeaderTemplate="{StaticResource SectionHeaderTemplate}"
                    Margin="0,0,40,0">
            <DataTemplate>
                <StackPanel>
                    <TextBlock Text="SACCO Overview" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource NavyBrush}" Margin="0,0,0,12"/>

                    <Canvas Width="480" Height="310" Background="White">

                        <Border Canvas.Left="16" Canvas.Top="30" Width="130" Height="84"
                                Background="{StaticResource BlueBrush}" CornerRadius="3">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL MEMBERS" Style="{StaticResource TileCaptionStyle}"/>
                                <TextBlock Text="1,250" Style="{StaticResource TileValueStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Canvas.Left="168" Canvas.Top="30" Width="130" Height="84"
                                Background="{StaticResource SlateBrush}" CornerRadius="3">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ACTIVE LOANS" Style="{StaticResource TileCaptionStyle}"/>
                                <TextBlock Text="286" Style="{StaticResource TileValueStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Canvas.Left="322" Canvas.Top="30" Width="130" Height="84"
                                Background="{StaticResource TileGoldBrush}" CornerRadius="3">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TODAY'S PAYMENTS" Style="{StaticResource TileCaptionStyle}"/>
                                <TextBlock Text="UGX 4.8M" Style="{StaticResource TileValueStyle}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Canvas.Left="20" Canvas.Top="210" Text="Member Savings"
                                   Style="{StaticResource StatCaptionStyle}"/>
                        <TextBlock Canvas.Left="20" Canvas.Top="232" Text="UGX 48.5M"
                                   Style="{StaticResource StatValueStyle}"/>

                        <TextBlock Canvas.Left="172" Canvas.Top="210" Text="Loans Issued"
                                   Style="{StaticResource StatCaptionStyle}"/>
                        <TextBlock Canvas.Left="172" Canvas.Top="232" Text="UGX 32.8M"
                                   Style="{StaticResource StatValueStyle}"/>

                        <TextBlock Canvas.Left="326" Canvas.Top="210" Text="Pending Loans"
                                   Style="{StaticResource StatCaptionStyle}"/>
                        <TextBlock Canvas.Left="326" Canvas.Top="232" Text="18"
                                   Style="{StaticResource StatValueStyle}"
                                   Foreground="{StaticResource TileGoldBrush}"/>
                    </Canvas>
                </StackPanel>
            </DataTemplate>
        </HubSection>

        <!-- Section 2: Member Services -->
        <HubSection Header="Member Services" HeaderTemplate="{StaticResource SectionHeaderTemplate}"
                    Margin="0,0,78,0">
            <DataTemplate>
                <StackPanel>
                    <TextBlock Text="Member Management" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource NavyBrush}" Margin="0,0,0,12"/>
                    <Button Content="Register New Member"       Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click"/>
                    <Button Content="Search Member"             Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click"/>
                    <Button Content="View Member Savings"       Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click"/>
                    <Button Content="Update Member Information" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click"/>
                </StackPanel>
            </DataTemplate>
        </HubSection>

        <!-- Section 3: Loan Services -->
        <HubSection Header="Loan Services" HeaderTemplate="{StaticResource SectionHeaderTemplate}"
                    Margin="0,0,78,0">
            <DataTemplate>
                <StackPanel>
                    <TextBlock Text="Loan Management" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource NavyBrush}" Margin="0,0,0,12"/>
                    <Button Content="New Loan Application" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click"/>
                    <Button Content="Approved Loans"       Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click"/>
                    <Button Content="Pending Loans"        Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click"/>
                    <Button Content="Loan Repayments"      Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click"/>
                </StackPanel>
            </DataTemplate>
        </HubSection>

        <!-- Section 4: Reports -->
        <HubSection Header="Reports" HeaderTemplate="{StaticResource SectionHeaderTemplate}">
            <DataTemplate>
                <StackPanel>
                    <TextBlock Text="SACCO Reports" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource NavyBrush}" Margin="0,0,0,12"/>
                    <Button Content="Daily Collections"          Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click"/>
                    <Button Content="Monthly Savings"            Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click"/>
                    <Button Content="Loan Repayment Report"      Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click"/>
                    <Button Content="Member Registration Report" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click"/>
                </StackPanel>
            </DataTemplate>
        </HubSection>
    </Hub>
</Page>